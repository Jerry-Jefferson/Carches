MONGO_INITDB_ROOT_USERNAME=your_username
MONGO_INITDB_ROOT_PASSWORD=your_password
MONGO_INITDB_DATABASE=carshes

ME_CONFIG_MONGODB_ADMINUSERNAME=your_username
ME_CONFIG_MONGODB_ADMINPASSWORD=your_password
ME_CONFIG_MONGODB_SERVER=mongodb

ME_CONFIG_BASICAUTH_USERNAME=your_username
ME_CONFIG_BASICAUTH_PASSWORD=your_password

ME_CONFIG_MONGODB_URL="mongodb://your_username:your_password@mongodb:27017/"

DATABASE_URI=mongodb://your_username:your_password@localhost:27018/carshes?authSource=admin

PORT=3000

JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_min_12_chars
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Carshes
ADMIN_LICENSE_NUMBER=ADMIN0001
