{
  "openapi": "3.0.0",
  "info": {
    "title": "Carshes API",
    "version": "1.0.0",
    "description": "API documentation for the Carshes car-sharing service"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "User registration and authentication"
    },
    {
      "name": "Cars",
      "description": "Car fleet management endpoints"
    },
    {
      "name": "Drivers",
      "description": "Driver management endpoints"
    },
    {
      "name": "Bookings",
      "description": "Booking management endpoints"
    }
  ],
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Sign up",
        "description": "Registers a new user. The password is hashed with bcrypt before being stored. Returns the created user and a JWT.",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "example": {
                  "message": "User successfully registered",
                  "data": {
                    "user": {
                      "_id": "66c5b2f4e1a2b3c4d5e6f7a8",
                      "email": "jane.doe@example.com",
                      "createdAt": "2026-10-26T10:00:00.000Z",
                      "updatedAt": "2026-10-26T10:00:00.000Z"
                    },
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body (missing fields, invalid email, password too short/long, malformed JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missing": {
                    "value": {
                      "status": "error",
                      "statusCode": 400,
                      "message": "Email and password are required and must be strings"
                    }
                  },
                  "invalidEmail": {
                    "value": {
                      "status": "error",
                      "statusCode": 400,
                      "message": "Email is invalid"
                    }
                  },
                  "shortPassword": {
                    "value": {
                      "status": "error",
                      "statusCode": 400,
                      "message": "Password must be at least 8 characters long"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "statusCode": 409,
                  "message": "A user with this email already exists"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "statusCode": 500,
                  "message": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "summary": "Sign in",
        "description": "Authenticates a user by email and password and returns a JWT to use in the `Authorization: Bearer <token>` header for protected routes.",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "example": {
                  "message": "Successfully signed in",
                  "data": {
                    "user": {
                      "_id": "66c5b2f4e1a2b3c4d5e6f7a8",
                      "email": "jane.doe@example.com",
                      "createdAt": "2026-10-26T10:00:00.000Z",
                      "updatedAt": "2026-10-26T10:00:00.000Z"
                    },
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed email/password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "statusCode": 400,
                  "message": "Email and password are required and must be strings"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "statusCode": 401,
                  "message": "Invalid email or password"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "statusCode": 500,
                  "message": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/cars": {
      "get": {
        "summary": "Get all cars",
        "description": "Returns a list of all cars in the system.",
        "tags": ["Cars"],
        "responses": {
          "200": {
            "description": "Successfully retrieved cars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Successfully retrieved all cars"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CarWithProductionInfo"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Add a new car",
        "description": "Adds a new car to the car-sharing park. Can optionally create a new ProductionInfo record if an object is provided instead of an ID.",
        "tags": ["Cars"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productionInfo": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/ProductionInfoInput"
                      },
                      {
                        "type": "string",
                        "description": "Existing ProductionInfo ObjectId"
                      }
                    ],
                    "description": "Either an existing ProductionInfo ID or an object to create a new one"
                  },
                  "vin": {
                    "type": "string",
                    "example": "12345678901234567",
                    "minLength": 17,
                    "maxLength": 17
                  },
                  "registrationNumber": {
                    "type": "string",
                    "example": "1234 AB-7"
                  },
                  "fuelLevel": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "example": 100
                  },
                  "mileage": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 50000
                  },
                  "location": {
                    "$ref": "#/components/schemas/GeoPoint"
                  }
                },
                "required": ["productionInfo", "vin", "registrationNumber", "location"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Car successfully added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data (validation error or duplicate field)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cars/in-use/low-fuel": {
      "get": {
        "summary": "Get cars in use with low fuel",
        "description": "Returns a list of cars that are currently in use and have a fuel level less than 25%. Results include populated production info.",
        "tags": ["Cars"],
        "responses": {
          "200": {
            "description": "Successfully retrieved cars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Successfully retrieved cars in use with low fuel"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CarWithProductionInfo"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cars/reserved": {
      "get": {
        "summary": "Get reserved cars by card authorization status",
        "description": "Returns a list of reserved cars filtered by whether the driver's credit/debit card is authorized. Includes driver details and car location.",
        "tags": ["Cars"],
        "parameters": [
          {
            "name": "authorized",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Filter by card authorization status (true = authorized, false = unauthorized)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved cars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Successfully retrieved reserved cars with unauthorized cards"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReservedCarUnauthorized"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cars/service-old-or-high-mileage": {
      "put": {
        "summary": "Send old or high mileage cars to service",
        "description": "Updates any car produced before 2017 or with mileage > 100,000 km by setting its status to 'in_service'.",
        "tags": ["Cars"],
        "responses": {
          "200": {
            "description": "Successfully updated cars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Successfully updated cars to in_service"
                    },
                    "data": {
                      "$ref": "#/components/schemas/UpdateResult"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cars/relocate-frequently-booked": {
      "put": {
        "summary": "Relocate frequently booked cars",
        "description": "Updates any car booked more than 2 times (and not currently 'in_use' or 'reserved') by setting its location to a central point in Minsk (27.5443, 53.8883).",
        "tags": ["Cars"],
        "responses": {
          "200": {
            "description": "Successfully updated locations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Successfully updated location for frequently booked cars"
                    },
                    "data": {
                      "$ref": "#/components/schemas/UpdateResult"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cars/{vin}": {
      "get": {
        "summary": "Get a car by VIN",
        "description": "Returns a single car matching the provided VIN.",
        "tags": ["Cars"],
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 17,
              "maxLength": 17
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved car",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Successfully retrieved car by VIN"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CarWithProductionInfo"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Car not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a car by VIN",
        "description": "Removes a car from the car-sharing park by its VIN.",
        "tags": ["Cars"],
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 17,
              "maxLength": 17
            },
            "description": "The 17-character Vehicle Identification Number"
          }
        ],
        "responses": {
          "204": {
            "description": "Car successfully deleted"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Car not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a car by VIN",
        "description": "Updates an existing car matching the provided VIN.",
        "tags": ["Cars"],
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 17,
              "maxLength": 17
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["free", "reserved", "in_use", "unavailable", "in_service"]
                  },
                  "fuelLevel": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "mileage": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "location": {
                    "$ref": "#/components/schemas/GeoPoint"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Car successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Car not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
