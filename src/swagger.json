        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT returned by /auth/signup or /auth/signin. Send as `Authorization: Bearer <token>`."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, malformed, invalid or expired token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "missingHeader": {
                "summary": "No Authorization header",
                "value": {
                  "status": "error",
                  "statusCode": 401,
                  "message": "Authorization header is missing"
                }
              },
              "badFormat": {
                "summary": "Wrong header format",
                "value": {
                  "status": "error",
                  "statusCode": 401,
                  "message": "Authorization header must be in the format: Bearer <token>"
                }
              },
              "invalid": {
                "summary": "Invalid token",
                "value": {
                  "status": "error",
                  "statusCode": 401,
                  "message": "Invalid token"
                }
              },
              "expired": {
                "summary": "Expired token",
                "value": {
                  "status": "error",
                  "statusCode": 401,
                  "message": "Token has expired"
                }
              }
            }
          }
        }
      }
    }
